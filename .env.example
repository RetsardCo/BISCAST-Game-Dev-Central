# BISCAST Game Dev Central — Environment Variables Template
# Phase 0-2 runs completely on local mock JSON data; no live Supabase project is connected yet.
# Antigravity (Phase 3+) will populate development/production values via Cloudflare Pages / local .env.
# NEVER expose a Supabase service-role key in any VITE_ variable or frontend bundle.

VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_APP_ENV=prototype
